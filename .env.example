# Adresse de la passerelle, sans /api/v1 (par exemple http://localhost:9080). Vide avec les mocks.
VITE_GATEWAY_BASE_URL=
VITE_USE_MOCKS=true
# Sections branchées sur le vrai backend pendant que le reste reste simulé, séparées par des virgules (par exemple offres).
# Modules disponibles : offres. Sans effet quand VITE_USE_MOCKS=false.
VITE_REAL_MODULES=
